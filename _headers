# --- 1. GLOBAL SECURITY HEADERS (Applies to all routes) ---
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# --- 2. STATIC ASSETS (Long Cache) ---
# We must define the rule for EACH extension individually.
# Cloudflare does not support grouping URLs.

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# --- 3. DYNAMIC CONTENT & DATA FILES (No Cache / Revalidate) ---

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.xml
  Cache-Control: public, max-age=0, must-revalidate

/*.json
  Cache-Control: public, max-age=0, must-revalidate

/*.txt
  Cache-Control: public, max-age=0, must-revalidate

/*.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# --- 4. SPECIFIC EXCEPTIONS (Critical Overrides) ---

# Service Worker must NEVER be cached for long.
/service-worker.js
  Cache-Control: no-cache, must-revalidate

# SEO exclusion for the 404 page
/404.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-cache

# Jampack generated images (hashed files)
/_jampack/*
  Cache-Control: public, max-age=31556952, immutable
