# --- 1. GLOBAL SECURITY HEADERS ---
/*
  # Prevent the site from being embedded in iframes (Clickjacking protection)
  X-Frame-Options: DENY
  
  # Prevent browsers from guessing media types (MIME sniffing protection)
  X-Content-Type-Options: nosniff
  
  # Control referrer information when linking to external sites
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unused browser features for better security/privacy score
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  
  # Force HTTPS (HSTS) - Cache for 1 year
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# --- 2. STATIC ASSETS (Long Cache) ---
# Safe to cache for 1 year because filenames usually don't change or use hashes
/*.css
/*.js
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
/*.avif
/*.ico
/*.svg
/*.woff
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# --- 3. DYNAMIC CONTENT & DATA FILES (No Cache / Revalidate) ---
# Files containing content data or config that update frequently
# Browser must check with the server before using the cached version
/*.html
/*.xml
/*.json
/*.txt
/*.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# --- 4. SPECIFIC EXCEPTIONS (Critical Overrides) ---

# CRITICAL: Overrides the global /*.js rule above.
# Service Worker must NEVER be cached for long, otherwise updates won't apply.
/service-worker.js
  Cache-Control: no-cache, must-revalidate

# SEO exclusion for the 404 page
/404.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-cache

# Jampack generated images (hashed files) can be cached forever
/_jampack/*
  Cache-Control: public, max-age=31556952, imversion
